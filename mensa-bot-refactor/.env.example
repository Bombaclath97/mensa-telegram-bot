# Copy to .env and fill in. Every variable the service reads is listed here;
# see ENVIRONMENT.md for the full description of each one.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather.
BOT_TOKEN=

# Mensa Italia API (membership verification + validity checks).
API_ENDPOINT=https://api.mensa.it/v1
API_BEARER_TOKEN=

# PUBLIC origin of this service plus the callback route path "/callme_api".
# The Mensa app is handed {CALLME_BASE_URL}/{token} and the service serves
# POST /callme_api/{token}, so anything else here makes every approval 404.
CALLME_BASE_URL=https://your-domain.example/callme_api

# Comma-separated Telegram user IDs flagged is_bot_admin on boot. These are the
# only users who may run /manual_add. Leave blank to disable /manual_add entirely.
ADMIN_TELEGRAM_IDS=

# --- HTTP server (plain HTTP; TLS terminated by a reverse proxy) ------------

# Bind address for the inbound HTTP server (GET /health, POST /callme_api/{token}).
HTTP_ADDR=:8080

# --- Storage (PostgreSQL) ---------------------------------------------------

# The bot is stateless: everything lives in Postgres and the schema auto-migrates on boot.
# Either set DATABASE_URL, or the discrete DB_* parts below. DATABASE_URL wins if both are set.
#
# compose.yaml sets the DB_* form for you and runs a postgres service; you only need this when
# running `go run .` against your own database.
DATABASE_URL=postgres://mensa:mensa@localhost:5432/mensa?sslmode=disable

# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=mensa
# DB_PASSWORD=mensa
# DB_NAME=mensa
# DB_SSLMODE=disable

# --- Secrets ----------------------------------------------------------------
#
# ANY variable can be supplied from a file with the conventional Docker suffix: X_FILE=/path
# makes the file's contents X. This is how Swarm delivers secrets (see DEPLOY.md).
#
#   BOT_TOKEN_FILE=/run/secrets/mensa_bot_token
#   DB_PASSWORD_FILE=/run/secrets/mensa_db_password
#
# Setting both X and X_FILE is a fatal error, not a silent preference.

# --- Translations (Tolgee) --------------------------------------------------

# Optional: the CDN and on-disk cache tiers work with no API key.
TOLGEE_API_KEY=
# Persist the fallback cache on a durable volume for cold-start-during-outage.
TOLGEE_CACHE_PATH=./tolgee-cache.json
# TOLGEE_CDN_PROJECT_ID=
# TOLGEE_CDN_URL=

# --- Timeouts ---------------------------------------------------------------

# Registration/manual-add wizard step TTL, in minutes (default 5).
CONVERSATION_TIMEOUT_MINUTES=5
# TTL of a draft parked AWAITING_APPROVAL from the Mensa app, in minutes (default 30).
# Approving happens in a separate app, so this is deliberately much longer than the
# wizard TTL and is NOT re-armed while locked.
APPROVAL_TIMEOUT_MINUTES=30

# --- Logging ----------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# --- Membership-expiry cleanup sweep (ticker-driven, destructive) -----------

# DEFAULTS TO TRUE: out of the box the sweep only logs what it WOULD remove.
CLEANUP_DRY_RUN=true
CLEANUP_INTERVAL_HOURS=24
# Circuit breakers: a sweep that would remove more than the limit aborts, touching nobody.
CLEANUP_MAX_DELETIONS=10
CLEANUP_MAX_FRACTION=0.25
CLEANUP_FRACTION_MIN_MEMBERS=20
CLEANUP_API_CONCURRENCY=4
CLEANUP_TELEGRAM_DELAY_MS=100
CLEANUP_SKIP_BOT_ADMINS=true

# How often /elimina's failed group removals are retried (minutes).
PENDING_REMOVAL_INTERVAL_MINUTES=60

# --- Group-sync backfill (one-shot repair) ----------------------------------

# Re-probes members stuck at groups_synced_at = NULL and stamps the ones that complete.
# Turn on for a SINGLE boot after repairing an unprobeable row in `groups`, then turn off.
# See ENVIRONMENT.md; leaving it on means the underlying group row is still broken.
GROUP_SYNC_BACKFILL=false
